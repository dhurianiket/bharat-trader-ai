//@version=5
strategy("AI Autonomous Intraday Engine [Webhook Ready]", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// ==========================================
// User Inputs & Strategy Parameters
// ==========================================
secret_key      = input.string("CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET", "Webhook Secret Key")
trade_symbol    = input.string("NIFTY", "Symbol Identifier for Broker")
product_type    = input.string("INTRADAY", "Product (INTRADAY / DELIVERY)", options=["INTRADAY", "DELIVERY"])
order_qty       = input.int(50, "Order Quantity (Shares or Lot Size)", minval=1)

// Trend Filter: EMA Fast & Slow
fast_len        = input.int(9, "Fast EMA Length")
slow_len        = input.int(21, "Slow EMA Length")
fast_ema        = ta.ema(close, fast_len)
slow_ema        = ta.ema(close, slow_len)

// Momentum: RSI
rsi_len         = input.int(14, "RSI Length")
rsi_val         = ta.rsi(close, rsi_len)

// Volatility & Trailing Stop: ATR
atr_len         = input.int(14, "ATR Length")
atr_val         = ta.atr(atr_len)
sl_multiplier   = input.float(1.5, "ATR Stop Loss Multiplier")
tp_multiplier   = input.float(3.0, "ATR Take Profit Multiplier")

// Plot EMAs
plot(fast_ema, color=color.blue, title="Fast EMA")
plot(slow_ema, color=color.orange, title="Slow EMA")

// ==========================================
// Strategy Logic & Conditions
// ==========================================
long_condition  = ta.crossover(fast_ema, slow_ema) and (rsi_val > 50) and (rsi_val < 70)
short_condition = ta.crossunder(fast_ema, slow_ema) and (rsi_val < 50) and (rsi_val > 30)

// Dynamic Stop Loss and Take Profit levels
var float long_sl = na
var float long_tp = na
var float short_sl = na
var float short_tp = na

if (long_condition and strategy.position_size == 0)
    long_sl := close - (atr_val * sl_multiplier)
    long_tp := close + (atr_val * tp_multiplier)
    strategy.entry("Long", strategy.long, qty=order_qty)
    
    // Construct Webhook Payload for BUY
    alert_json = '{"secret_key":"' + secret_key + '","symbol":"' + trade_symbol + '","action":"BUY","quantity":' + str.tostring(order_qty) + ',"order_type":"MARKET","stop_loss":' + str.tostring(long_sl, "#.##") + ',"take_profit":' + str.tostring(long_tp, "#.##") + ',"product":"' + product_type + '","strategy_name":"TV_EMA_RSI"}'
    alert(alert_json, alert.freq_once_per_bar_close)

if (short_condition and strategy.position_size == 0)
    short_sl := close + (atr_val * sl_multiplier)
    short_tp := close - (atr_val * tp_multiplier)
    strategy.entry("Short", strategy.short, qty=order_qty)
    
    // Construct Webhook Payload for SELL
    alert_json = '{"secret_key":"' + secret_key + '","symbol":"' + trade_symbol + '","action":"SELL","quantity":' + str.tostring(order_qty) + ',"order_type":"MARKET","stop_loss":' + str.tostring(short_sl, "#.##") + ',"take_profit":' + str.tostring(short_tp, "#.##") + ',"product":"' + product_type + '","strategy_name":"TV_EMA_RSI"}'
    alert(alert_json, alert.freq_once_per_bar_close)

// Close on Stop Loss / Take Profit
if (strategy.position_size > 0)
    if (close <= long_sl or close >= long_tp)
        strategy.close("Long", comment="SL/TP Hit")
        exit_json = '{"secret_key":"' + secret_key + '","symbol":"' + trade_symbol + '","action":"SELL","quantity":' + str.tostring(order_qty) + ',"order_type":"MARKET","product":"' + product_type + '","strategy_name":"TV_EXIT"}'
        alert(exit_json, alert.freq_once_per_bar_close)

if (strategy.position_size < 0)
    if (close >= short_sl or close <= short_tp)
        strategy.close("Short", comment="SL/TP Hit")
        exit_json = '{"secret_key":"' + secret_key + '","symbol":"' + trade_symbol + '","action":"BUY","quantity":' + str.tostring(order_qty) + ',"order_type":"MARKET","product":"' + product_type + '","strategy_name":"TV_EXIT"}'
        alert(exit_json, alert.freq_once_per_bar_close)
